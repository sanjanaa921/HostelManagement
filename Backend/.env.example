# ==========================================
# Hostel Management System - Backend Environment
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/hosteldb
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hosteldb?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hosteldb

# JWT Secrets for Token Authentication (Use strong random strings in production)
JWT_SECRET=your_student_jwt_secret_change_in_production
JWT_ADMIN_SECRET=your_admin_jwt_secret_change_in_production

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# Python Face Recognition Microservice URL
PYTHON_SERVICE_URL=http://localhost:8085

# Campus Geofencing Settings (Latitude, Longitude, Radius in Meters)
# Default is NITJ Campus coordinates
CAMPUS_LAT=31.398038
CAMPUS_LON=75.531505
CAMPUS_RADIUS_METERS=500

# Security flags
ALLOW_ADMIN_CREATION=false
STRICT_GPS=false
STRICT_FACE=false
