# ==========================================
# Hostel Management System - Frontend Environment
# ==========================================

# Prevent browser from auto-opening on react-scripts start
BROWSER=none

# React Development Server Port
PORT=3000

# Backend API Base URL (leave blank for local development on localhost:5000)
# Example for production: https://hostel-api.yourdomain.com
REACT_APP_API_URL=http://localhost:5000
